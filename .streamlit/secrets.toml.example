# Plantilla de secrets para autenticación + roles.
# Copiar a `.streamlit/secrets.toml` (gitignored) y rellenar con valores reales.
# En producción vive en /opt/aly-dashboard/.streamlit/secrets.toml de plural-aly (ver CLAUDE.md, «Despliegue»).
#
# Las contraseñas se guardan como hash bcrypt (NUNCA en texto plano). Generar con:
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'TU_PASSWORD', bcrypt.gensalt()).decode())"

# Conexión a la DB: va en .env, en local y en producción.
# DATABASE_URL = "postgresql://..."

# Llave de los IDs seudónimos de la exportación sin identificar (utils/pseudonym.py).
# Tiene que ser LA MISMA que el secret PSEUDONYM_KEY de Estudio-Plural/aly-weekly-report,
# para que el ID de cada persona coincida con el del Excel de los lunes. Normalmente va en .env;
# si se pone acá, arriba de cualquier [sección]: debajo de [cookie] pasa a ser cookie.PSEUDONYM_KEY y no se lee.
# PSEUDONYM_KEY = "..."

[cookie]
name        = "aly_dashboard_auth"
key         = "CAMBIAR_POR_UN_SECRETO_ALEATORIO"   # python3 -c "import secrets; print(secrets.token_hex(32))"
expiry_days = 30

# ── Credenciales ────────────────────────────────────────────────────────────
# Una sección [credentials.usernames.<usuario>] por cuenta. El <usuario> es lo
# que se teclea en el login y es INDEPENDIENTE del rol: el rol sale de la lista
# `roles` de abajo, y es el que decide qué bots ve la cuenta.
#
# Los nombres de acá son los que están en producción — la convención es
# `<programa>_user`, con `superadmin` como excepción histórica para el admin.
[credentials.usernames.superadmin]
email    = "admin@apapacho.local"
name     = "Administrador"
password = "$2b$12$REEMPLAZAR_POR_HASH_BCRYPT"
roles    = ["admin"]

[credentials.usernames.apapachar_user]
email    = "apapachar@apapacho.local"
name     = "Apapachar"
password = "$2b$12$REEMPLAZAR_POR_HASH_BCRYPT"
roles    = ["apapachar"]

# Semillas de Igualdad (Equimundo + GENDES / Tec de Monterrey) — docentes de
# preescolar en el Estado de México. Solo ve datos del bot_id "mexico".
[credentials.usernames.mexico_user]
email    = "mexico@apapacho.local"
name     = "Semillas México"
password = "$2b$12$REEMPLAZAR_POR_HASH_BCRYPT"
roles    = ["mexico"]

# ── Mapeo rol → bots permitidos ─────────────────────────────────────────────
# "*" = todos los bots disponibles en la DB.
[roles]
admin     = ["*"]
apapachar = ["apapachar"]
mexico    = ["mexico"]
